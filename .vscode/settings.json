{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "tailwindCSS.includeLanguages": {
    "plaintext": "ts",
    "typescript": "ts",
    "typescriptreact": "tsx"
  },
  "workbench.colorCustomizations": {
    "commandCenter.border": "#e7e7e799",
    "commandCenter.foreground": "#e7e7e7",
    "sash.hoverBorder": "#3333ff",
    "statusBar.background": "#0000ff",
    "statusBar.debuggingBackground": "#0000ff",
    "statusBar.debuggingForeground": "#e7e7e7",
    "statusBar.foreground": "#e7e7e7",
    "statusBar.inactiveBackground": "#0000ff",
    "statusBarItem.hoverBackground": "#3333ff",
    "statusBarItem.remoteBackground": "#400000",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "tab.activeBackground": "#3333ff",
    "tab.activeBorder": "#3333ff",
    "titleBar.activeBackground": "#0000ff",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#0000ff99",
    "titleBar.inactiveForeground": "#e7e7e799",
    "window.activeBorder": "#3333ff",
    "window.inactiveBorder": "#3333ff"
  }
}
